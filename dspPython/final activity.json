        "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Rice Guardian Daily Report</title>\n    <style>\n        /* RESET & BASE */\n        body { margin: 0; padding: 0; background-color: #f0f2f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; -webkit-font-smoothing: antialiased; }\n        table { border-spacing: 0; border-collapse: collapse; }\n        td { padding: 0; }\n        \n        /* LAYOUT */\n        .wrapper { width: 100%; table-layout: fixed; background-color: #f0f2f5; padding: 40px 0; }\n        .card { max-width: 600px; background-color: #ffffff; margin: 0 auto; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }\n        \n        /* HEADER */\n        .header { background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 30px; text-align: center; color: white; }\n        .header h1 { margin: 0; font-size: 22px; letter-spacing: 0.5px; text-transform: uppercase; font-weight: 700; }\n        .date-badge { display: inline-block; background-color: rgba(255,255,255,0.2); border-radius: 20px; padding: 5px 15px; margin-top: 10px; font-size: 13px; }\n        \n        /* HERO SECTION (Level) */\n        .hero { padding: 40px 30px; text-align: center; border-bottom: 1px solid #f0f0f0; }\n        .level-label { color: #64748b; font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; margin-bottom: 15px; }\n        .level-number { color: #111827; font-size: 72px; font-weight: 800; margin: 0; line-height: 1; letter-spacing: -2px; }\n        .level-unit { font-size: 28px; color: #9ca3af; vertical-align: super; font-weight: 400; }\n        \n        /* PROGRESS BAR */\n        .progress-container { background-color: #f3f4f6; border-radius: 10px; height: 12px; width: 100%; max-width: 300px; margin: 20px auto 10px auto; overflow: hidden; }\n        .progress-fill { height: 100%; background-color: #10b981; border-radius: 10px; transition: width 0.5s ease; }\n        \n        /* AI BOX */\n        .ai-box { background-color: #f8fafc; border: 1px solid #e2e8f0; margin: 30px; padding: 25px; border-radius: 8px; position: relative; }\n        .ai-icon { position: absolute; top: -15px; left: 20px; background-color: #3b82f6; color: white; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; box-shadow: 0 4px 6px rgba(59, 130, 246, 0.2); }\n        .ai-text { color: #334155; font-size: 15px; line-height: 1.6; font-style: italic; }\n\n        /* METRICS GRID */\n        .stats-grid { width: 100%; border-top: 1px solid #f0f0f0; }\n        .stat-col { width: 50%; text-align: center; padding: 25px; }\n        .stat-val { font-size: 24px; font-weight: 700; color: #1e293b; }\n        .stat-label { font-size: 12px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 5px; }\n        \n        /* FOOTER */\n        .footer { text-align: center; padding: 30px; color: #94a3b8; font-size: 12px; line-height: 1.5; }\n        .footer a { color: #64748b; text-decoration: none; font-weight: 600; }\n    </style>\n</head>\n<body>\n    <div class=\"wrapper\">\n        <div class=\"card\">\n            <div class=\"header\">\n                <h1>🍚 Daily Status Report</h1>\n                <div class=\"date-badge\">Generated: {{ new Date().toLocaleDateString() }}</div>\n            </div>\n\n            <div class=\"hero\">\n                <div class=\"level-label\">Current Rice Inventory</div>\n                \n                <div class=\"level-number\">\n                    {{ $('Webhook').item.json.body.level_percent }}<span class=\"level-unit\">%</span>\n                </div>\n\n                <div class=\"progress-container\">\n                    <div class=\"progress-fill\" style=\"width: {{ $('Webhook').item.json.body.level_percent }}%;\"></div>\n                </div>\n\n                <div style=\"color: #94a3b8; font-size: 13px; margin-top: 10px;\">\n                    Sensor Depth: {{ $('Webhook').item.json.body.distance_mm }}mm\n                </div>\n            </div>\n\n            <div class=\"ai-box\">\n                <span class=\"ai-icon\">✨ AI Analysis</span>\n                <div class=\"ai-text\">\n                    {{ $json.candidates[0].content.parts[0].text }}\n                </div>\n            </div>\n\n            <table class=\"stats-grid\">\n                <tr>\n                    <td class=\"stat-col\" style=\"border-right: 1px solid #f0f0f0;\">\n                        <div class=\"stat-val\">{{ $('Webhook').item.json.body.humidity }}%</div>\n                        <div class=\"stat-label\">Humidity</div>\n                    </td>\n                    <td class=\"stat-col\">\n                        <div class=\"stat-val\">{{ $('Webhook').item.json.body.temperature }}°C</div>\n                        <div class=\"stat-label\">Temperature</div>\n                    </td>\n                </tr>\n            </table>\n        </div>\n\n        <div class=\"footer\">\n            <strong>Rice Guardian IoT System</strong><br>\n            Powered by ESP32 & n8n Automation<br>\n            <br>\n            <a href=\"#\">Open Dashboard</a>\n        </div>\n    </div>\n</body>\n</html>"
