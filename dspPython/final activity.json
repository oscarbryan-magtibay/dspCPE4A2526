        "jsCode": "// Get the \"Memory\" of this workflow\nconst staticData = $getWorkflowStaticData('global');\n\n// --- UNIQUE MEMORY KEY ---\n// We use 'lastBukbokAlert' so it tracks separately from the Rice Level\nconst lastAlert = staticData.lastBukbokAlert || 0; \nconst now = new Date().getTime();\n\n// --- TIMER SETTING ---\n// FOR TESTING: 1 Minute\nconst timeLimit = 1 * 60 * 1000; \n// FOR REAL (30 Mins): const timeLimit = 30 * 60 * 1000;\n\n// --- LOGIC START ---\n\n// CHECK TIMER:\n// This code assumes the humidity is ALREADY high (checked by the previous IF node).\n// We just check if enough time has passed to send another alert.\n\nif (now - lastAlert > timeLimit) {\n  // It has been more than the time limit (1 min for now)\n  staticData.lastBukbokAlert = now; // Update the memory timestamp\n  return items; // Allow the alert to proceed\n} else {\n  // Too soon! Block the spam.\n  return []; // Stop the workflow (No email)\n}"
