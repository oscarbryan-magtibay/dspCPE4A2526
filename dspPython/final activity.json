        "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>High Humidity Alert</title>\n    <style>\n        /* RESET & BASE */\n        body { margin: 0; padding: 0; background-color: #f0f2f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; -webkit-font-smoothing: antialiased; }\n        table { border-spacing: 0; border-collapse: collapse; }\n        td { padding: 0; }\n        \n        /* LAYOUT */\n        .wrapper { width: 100%; table-layout: fixed; background-color: #f0f2f5; padding: 40px 0; }\n        .card { max-width: 600px; background-color: #ffffff; margin: 0 auto; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid #fee2e2; }\n        \n        /* HEADER - URGENT RED THEME */\n        .header { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); padding: 30px; text-align: center; color: white; }\n        .header h1 { margin: 0; font-size: 24px; letter-spacing: 0.5px; text-transform: uppercase; font-weight: 800; }\n        .alert-badge { display: inline-block; background-color: rgba(255,255,255,0.25); border-radius: 20px; padding: 5px 15px; margin-top: 10px; font-size: 13px; font-weight: bold; }\n        \n        /* HERO SECTION (Humidity Focus) */\n        .hero { padding: 40px 30px; text-align: center; border-bottom: 1px solid #f0f0f0; background-color: #fff1f2; }\n        .level-label { color: #991b1b; font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; margin-bottom: 15px; }\n        .level-number { color: #dc2626; font-size: 72px; font-weight: 800; margin: 0; line-height: 1; letter-spacing: -2px; }\n        .level-unit { font-size: 28px; color: #ef4444; vertical-align: super; font-weight: 400; }\n        .sub-alert { color: #b91c1c; font-weight: bold; margin-top: 10px; font-size: 14px; }\n        \n        /* AI BOX */\n        .ai-box { background-color: #fffaf0; border-left: 4px solid #f59e0b; margin: 30px; padding: 25px; border-radius: 4px; position: relative; }\n        .ai-title { color: #b45309; font-weight: bold; font-size: 13px; text-transform: uppercase; margin-bottom: 10px; display: block; }\n        .ai-text { color: #451a03; font-size: 16px; line-height: 1.6; font-style: italic; }\n\n        /* METRICS GRID */\n        .stats-grid { width: 100%; border-top: 1px solid #f0f0f0; }\n        .stat-col { width: 50%; text-align: center; padding: 25px; }\n        .stat-val { font-size: 20px; font-weight: 700; color: #1e293b; }\n        .stat-label { font-size: 12px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 5px; }\n        \n        /* FOOTER */\n        .footer { text-align: center; padding: 30px; color: #94a3b8; font-size: 12px; line-height: 1.5; }\n    </style>\n</head>\n<body>\n    <div class=\"wrapper\">\n        <div class=\"card\">\n            <div class=\"header\">\n                <h1>⚠️ Bukbok Risk Alert</h1>\n                <div class=\"alert-badge\">ACTION REQUIRED</div>\n            </div>\n\n            <div class=\"hero\">\n                <div class=\"level-label\">Moisture Level Detected</div>\n                \n                <div class=\"level-number\">\n                    {{ $('Webhook').item.json.body.humidity }}<span class=\"level-unit\">%</span>\n                </div>\n\n                <div class=\"sub-alert\">\n                    Environment Critical for Weevil Growth\n                </div>\n            </div>\n\n            <div class=\"ai-box\">\n                <span class=\"ai-title\">🤖 Guardian AI Advice</span>\n                <div class=\"ai-text\">\n                    {{ $json.content.parts[0].text }}\n                </div>\n            </div>\n\n            <table class=\"stats-grid\">\n                <tr>\n                    <td class=\"stat-col\" style=\"border-right: 1px solid #f0f0f0;\">\n                        <div class=\"stat-val\">{{ $('Webhook').item.json.body.temperature }}°C</div>\n                        <div class=\"stat-label\">Temperature</div>\n                    </td>\n                    <td class=\"stat-col\">\n                        <div class=\"stat-val\">{{ $('Webhook').item.json.body.level_percent }}%</div>\n                        <div class=\"stat-label\">Current Rice Stock</div>\n                    </td>\n                </tr>\n            </table>\n        </div>\n\n        <div class=\"footer\">\n            <strong>Rice Guardian IoT System</strong><br>\n            Protecting your grain from moisture & pests.<br>\n        </div>\n    </div>\n</body>\n</html>"
