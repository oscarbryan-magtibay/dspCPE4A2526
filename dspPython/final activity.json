        "jsCode": "// Get the \"Memory\" of this workflow\nconst staticData = $getWorkflowStaticData('global');\n\n// Get the last time we sent an alert (default to 0 if never sent)\nconst lastAlert = staticData.lastStockAlert || 0; // Renamed variable slightly to reflect general usage\nconst now = new Date().getTime();\n\n// --- TIMER SETTING ---\n// FOR TESTING: 1 Minute\nconst timeLimit = 1 * 60 * 1000; \n// FOR REAL (24 Hours): const timeLimit = 24 * 60 * 60 * 1000;\n\n// --- LOGIC START ---\n\n// Check if the time limit has passed since the last alert\nif (now - lastAlert > timeLimit) {\n    // Yes, it is time for the daily (or minutely) update!\n    \n    // 1. Update the memory to right now\n    staticData.lastStockAlert = now;\n    \n    // 2. Send the report (Pass the item through)\n    return items;\n} else {\n    // No, it's too soon.\n    // Stop the workflow.\n    return [];\n}"
      },
