        "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\n  /* Base Styles */\n  body { margin: 0; padding: 0; font-family: 'Segoe UI', Helvetica, Arial, sans-serif; background-color: #f0f2f5; color: #333; }\n  .container { max-width: 600px; margin: 20px auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.08); }\n  \n  /* Header */\n  .header { background: linear-gradient(135deg, #4CAF50, #2E7D32); color: white; padding: 30px 20px; text-align: center; }\n  .header h1 { margin: 0; font-size: 24px; font-weight: 600; letter-spacing: 0.5px; }\n  .header p { margin: 5px 0 0; opacity: 0.9; font-size: 14px; }\n\n  /* Metrics Grid */\n  .metrics-container { padding: 20px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }\n  .metric-card { flex: 1; min-width: 140px; background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 15px; text-align: center; }\n  .metric-card strong { display: block; font-size: 22px; color: #2E7D32; margin-bottom: 4px; }\n  .metric-card span { font-size: 12px; color: #6c757d; text-transform: uppercase; letter-spacing: 1px; font-weight: bold; }\n  \n  /* Icons (Emojis as fallback) */\n  .icon { font-size: 20px; margin-bottom: 5px; display: block; }\n\n  /* AI Advice Section */\n  .advice-section { padding: 0 30px 30px; }\n  .advice-card { background-color: #fff8e1; border-left: 4px solid #ffb300; padding: 20px; border-radius: 4px; position: relative; }\n  .advice-title { font-weight: bold; color: #ff8f00; margin-bottom: 8px; display: block; font-size: 14px; text-transform: uppercase; }\n  .advice-text { font-style: italic; line-height: 1.5; color: #444; font-size: 16px; }\n\n  /* Footer */\n  .footer { background-color: #f8f9fa; padding: 15px; text-align: center; font-size: 11px; color: #999; border-top: 1px solid #eee; }\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n  <div clas